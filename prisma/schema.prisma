datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Store Owner / Staff User
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// 2. Product Category
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

// 3. Product Catalog
model Product {
  id            String        @id @default(cuid())
  name          String
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchasePrice Decimal       @default(0) @db.Decimal(10, 2)
  sellingPrice  Decimal       @default(0) @db.Decimal(10, 2)
  stock         Int           @default(0)
  minStock      Int           @default(5)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  saleItems     SaleItem[]
  inwards       StockInward[]

  @@index([categoryId])
  @@index([isActive])
  @@index([stock])
}

// 4. Sales Records
model Sale {
  id          String     @id @default(cuid())
  saleNumber  String     @unique
  totalAmount Decimal    @default(0) @db.Decimal(10, 2) // Total Revenue
  totalCost   Decimal    @default(0) @db.Decimal(10, 2) // Purchase cost of sold items
  profit      Decimal    @default(0) @db.Decimal(10, 2) // totalAmount - totalCost
  createdAt   DateTime   @default(now())
  items       SaleItem[]

  @@index([createdAt])
}

// 5. Sale Line Items (Preserves price & cost snapshots)
model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String   // Snapshot of product name
  quantity    Int
  unitCost    Decimal  @default(0) @db.Decimal(10, 2) // Snapshot of purchase price
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2) // Snapshot of selling price
  subtotal    Decimal  @default(0) @db.Decimal(10, 2) // quantity * unitPrice
  createdAt   DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

// 6. Stock Inward / Inventory Additions (Tracks date, product, quantity added)
model StockInward {
  id           String   @id @default(cuid())
  inwardNumber String   @unique // e.g. INW-104928
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName  String   // Snapshot of product name
  quantity     Int      // Quantity of units added
  type         String   @default("RESTOCK") // "INITIAL_STOCK" | "RESTOCK" | "ADJUSTMENT"
  notes        String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}
